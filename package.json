  },
  "devDependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "6.5.0",
    "@codemirror/view": "6.38.6",
    "@semantic-release/exec": "^7.1.0",
    "@types/node": "^26.5.0",
    "esbuild": "^0.28.2",
    "obsidian": "^1.13.1",
    "semantic-release": "^25.0.9",
    "typescript": "^5.9.0",
    "vitest": "^5.0.0"
